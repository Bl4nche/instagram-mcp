# Easiest: run `uv run instagram-mcp setup`, which fills this file for you in
# ~/.instagram-mcp/.env (outside the repository, private to you).
# Never commit a real .env: it holds your access token.

# How you got the token (see README, section 1):
#   facebook  = unified login (new Meta apps) or Page token: does not expire
#   instagram = "API setup with Instagram login": expires after 60 days
IG_LOGIN=facebook

IG_ACCESS_TOKEN=

# facebook: numeric Instagram account ID (starts with 1784...). instagram: me
IG_USER_ID=

# Optional
IG_API_VERSION=v26.0
IG_DB_PATH=instagram_history.db
